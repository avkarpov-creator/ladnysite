# Пример для хостового Nginx: /etc/nginx/sites-available/ladnysite.conf
# Замените ladnysite.ru на ваш домен, затем: sudo certbot --nginx -d ladnysite.ru -d www.ladnysite.ru
server {
    listen 80;
    server_name ladnysite.ru www.ladnysite.ru;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
